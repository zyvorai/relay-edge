# Direct Relay stack — relay-edge → Relay only (no relay-pubsub)
# Copy and source before running direct e2e:
#   cp config/lab-direct.env.example config/lab-direct.env
#   # fill RELAY_AUTH_TOKEN (or use demo login via RELAY_DEMO_*)
#   set -a && source config/lab-direct.env && set +a
#
# relay-edge must be started with GATEWAY_BASE_URL empty:
#   RELAY_EDGE_DIRECT=1 RELAY_AUTH_TOKEN=... ./scripts/deploy-remote.sh <host> [user]
#
# Run:
#   ./scripts/stack-probe.sh --direct
#   ./scripts/e2e-direct-relay.sh
#   ./scripts/e2e-direct-stack.sh   # probe + matrix

BASE=https://<relay-host>:8443
# Lab 175: BASE=https://175.110.122.71:18080
EDGE=https://<edge-host>:18086
RELAY_AUTH_TOKEN=
RELAY_TLS_INSECURE=1
RELAY_DEMO_USER=demo
RELAY_DEMO_PASSWORD=demo
