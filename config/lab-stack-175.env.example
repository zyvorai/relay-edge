# Lab 175 — example URLs (Relay :18080, pubsub :8081, console :8082, edge :18086)
# Copy and source FROM YOUR WORKSTATION (not on the lab box):
#   cp config/lab-stack-175.env.example config/lab-stack-175.env
#   # fill RELAY_AUTH_TOKEN from: curl -fsSk -X POST $BASE/v1/auth/login …
#   set -a && source config/lab-stack-175.env && set +a
#   ./scripts/e2e-stack.sh
#
# These are remote host URLs. Do not replace them with 127.0.0.1 when running
# e2e from your laptop — Relay / pubsub / edge may also be split across hosts;
# always point BASE, GATEWAY, and EDGE at wherever each service actually listens.
#
# Process-local wiring on each host (only when peers share that host):
#   pubsub RELAY_BASE_URL → that host’s Relay
#   edge GATEWAY_BASE_URL → that host’s pubsub (or remote pubsub URL)
#   Relay RELAY_ACTION_TARGETS → reachable pubsub /v1/actions (127.0.0.1 only if co-located)

BASE=https://175.110.122.71:18080
GATEWAY=https://175.110.122.71:8081
EDGE=https://175.110.122.71:18086
FORGE_BASE=
FORGE_API_KEY=
RELAY_AUTH_TOKEN=
RELAY_TLS_INSECURE=1
RELAY_DEMO_USER=demo
RELAY_DEMO_PASSWORD=demo
PROJECT=fasal-onprem
