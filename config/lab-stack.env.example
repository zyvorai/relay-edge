# Lab stack — relay-edge + relay-pubsub + Relay (+ optional Forge)
# Copy and source before running stack-probe.sh or e2e-forge-stack.sh:
#   cp config/lab-stack.env.example config/lab-stack.env
#   # fill RELAY_AUTH_TOKEN and FORGE_API_KEY
#   set -a && source config/lab-stack.env && set +a
#
# RELAY_FORGE_* must be set on the Relay process (not relay-edge):
#   RELAY_FORGE_BASE_URL=$FORGE_BASE RELAY_FORGE_API_KEY=$FORGE_API_KEY
# Relay also needs RELAY_TLS_INSECURE=1 when action targets use HTTPS to pubsub.
# After Relay restart, re-sync relay-pubsub RELAY_AUTH_TOKEN (same demo login JWT).

BASE=https://<relay-host>:8443
GATEWAY=https://<gateway-host>:8081
EDGE=http://<edge-host>:18086
FORGE_BASE=http://<forge-host>:30631
FORGE_API_KEY=
RELAY_AUTH_TOKEN=
RELAY_TLS_INSECURE=1
RELAY_DEMO_USER=demo
RELAY_DEMO_PASSWORD=demo
PROJECT=fasal-onprem
